+/// The parser's `attrlist` operations, shared by defaults and statement attributes.
+/// C: lib/cgraph/grammar.y:appendattr
+trait AttrSink<'a> {
+    fn contains_key(&self, key: &str) -> bool;
+    fn set(&mut self, key: Cow<'a, str>, value: Cow<'a, str>, html: bool);
+}
+
+impl<'a> AttrSink<'a> for AttrMap {
+    fn contains_key(&self, key: &str) -> bool {
+        AttrMap::contains_key(self, key)
+    }
+
+    fn set(&mut self, key: Cow<'a, str>, value: Cow<'a, str>, html: bool) {
+        AttrMap::set(self, &key, value.into_owned(), html);
+    }
+}
+
+/// A one-attribute statement needs no temporary map. Wider lists retain AttrMap's
+/// normal ordering, replacement and growth; there is no retained parser scratch.
+/// C: lib/cgraph/grammar.y:optattr; appendattr; endnode
+#[derive(Default)]
+enum StatementAttrs<'a> {
+    #[default]
+    Empty,
+    One {
+        key: Cow<'a, str>,
+        value: Cow<'a, str>,
+        html: bool,
+    },
+    Map(AttrMap),
+}
+
+impl StatementAttrs<'_> {
+    fn into_map(self) -> AttrMap {
+        match self {
+            Self::Empty => AttrMap::new(),
+            Self::One { key, value, html } => {
+                let mut map = AttrMap::new();
+                map.set_owned(key.into_owned(), value.into_owned(), html);
+                map
+            }
+            Self::Map(map) => map,
+        }
+    }
+}
+
+impl<'a> AttrSink<'a> for StatementAttrs<'a> {
+    fn contains_key(&self, key: &str) -> bool {
+        match self {
+            Self::Empty => false,
+            Self::One { key: stored, .. } => stored == key,
+            Self::Map(map) => map.contains_key(key),
+        }
+    }
+
+    fn set(&mut self, key: Cow<'a, str>, value: Cow<'a, str>, html: bool) {
+        match self {
+            Self::Empty => *self = Self::One { key, value, html },
+            Self::One {
+                key: stored,
+                value: old,
+                html: old_html,
+            } if stored == &key => {
+                *old = value;
+                *old_html = html;
+            }
+            Self::One { .. } => {
+                let mut map = std::mem::take(self).into_map();
+                map.set(&key, value.into_owned(), html);
+                *self = Self::Map(map);
+            }
+            Self::Map(map) => {
+                map.set(&key, value.into_owned(), html);
+            }
+        }
+    }
+}
