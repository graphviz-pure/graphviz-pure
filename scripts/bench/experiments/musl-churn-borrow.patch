+    /// C: lib/cgraph/attr.c:agxset
+    pub fn set_owned(&mut self, key: String, value: String, html: bool) -> Option<String> {
+        if html {
+            self.html.insert(key.clone());
+        } else {
+            self.html.remove(&key);
+        }
+        self.insert_owned(key, value)
+    }
