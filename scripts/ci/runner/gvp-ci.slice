# The self-hosted runners' share of this machine (docs/ci/self-hosted-runners.md): at most half
# its 28 CPUs and about half its memory, and a low weight, so the runners yield to everything
# else, the delegates' gvp-delegates group included, whenever the CPUs are contended.
[Unit]
Description=graphviz-pure self-hosted CI runners

[Slice]
CPUAccounting=yes
CPUQuota=1400%
CPUWeight=20
MemoryAccounting=yes
MemoryHigh=40G
MemoryMax=43G
IOAccounting=yes
IOWeight=20
TasksMax=65536
