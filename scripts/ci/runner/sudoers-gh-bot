# /etc/sudoers.d/gvp-ci-gh-bot (installed by install.sh only while GVP_ACTIONS_TOKEN=gh-bot):
# lets the service user mint gh-bot's App token, which the watchdog's cancel and re-run use.
# That token can do far more than cancel and re-run; once the service token has the
# repository permission Actions (read and write), set GVP_ACTIONS_TOKEN=service and run
# install.sh again, which removes this file.
gvp-ci ALL=(root) NOPASSWD: /usr/local/sbin/gvp-app-token-mint ""
